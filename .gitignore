# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.env

# Rust verifier build output (Cargo.lock IS committed — do not ignore it)
verifier/target/

# Compiled / JIT artifacts
*.so

# spark-bench binaries (built in-place by `make`)
/spark-bench/test_field
/spark-bench/test_ntt
/spark-bench/test_blake3
/spark-bench/test_blake3_multi
/spark-bench/bench_field_mul
/spark-bench/bench_ntt
/spark-bench/bench_blake3_columns
/spark-bench/bench_goldilocks_matmul

# Generated artifacts (proofs, logits)
*.npy
proof*.json
logits*.npy
.claude/

# Local environment — reproduced from requirements.txt and the HF cache, not
# committed: the venv is ~5 GB and the model checkpoints ~11 GB.
venv/
models/
.hf_cache/

# Agent/editor backups — history is the place for old versions, not the tree
*.bak
*.bak[0-9]
*.bak-*

# Model enrolment handles. Each carries the SECRET zk-padding seed the weight
# commitment was made under -- the padding is the only thing hiding the weights
# in the columns a proof opens, so a published seed publishes the model. They
# also carry the opening ledger, which is per-deployment state, not source.
# Provision like the interlock PSK: minted once by app/enroll.sh, never committed.
.enroll/
